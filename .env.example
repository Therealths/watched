# Copie ce fichier en .env et remplis-le. Le fichier .env n'est jamais envoyé sur GitHub.

# Clé API TMDB (themoviedb.org → Paramètres → API) : la "clé API" ou le "jeton d'accès en lecture".
TMDB_KEY=

# Port du serveur (http://localhost:8787)
PORT=8787

# 0.0.0.0 = accessible depuis les autres appareils du Wi-Fi ; 127.0.0.1 = seulement ce PC
# (à mettre une fois Tailscale Funnel en place : c'est lui qui rend l'appli accessible).
HOST=0.0.0.0
